# Normalize line endings in the repository to LF on every platform. Checkouts on
# Windows may still use CRLF unless core.autocrlf=false; .editorconfig pins the
# formatter to LF so formatting checks behave identically on every OS.
* text=auto eol=lf

# Byte-exact fixtures and generated/compiled artifacts: never normalize.
*.bin -text
*.dat -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.nupkg binary
*.snupkg binary
