<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>BrDocs.DataAnnotations</PackageId>
    <Title>BrDocs.DataAnnotations — validation attributes for Brazilian documents</Title>
    <Description>
      ASP.NET/Core-compatible validation attributes ([Cpf], [Cnpj], [Cep], ...) that delegate to the
      BrDocs core value objects. Error messages in pt-BR with overridable resources.
    </Description>
    <PackageTags>brazil;cpf;cnpj;cep;validation;dataannotations;brdocs</PackageTags>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrDocs\BrDocs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ValidationMessages.resx">
      <LogicalName>BrDocs.DataAnnotations.ValidationMessages.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
